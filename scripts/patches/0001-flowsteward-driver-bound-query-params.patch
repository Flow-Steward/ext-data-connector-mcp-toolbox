+func TestNumberedMapPreservesOccurrenceOrder(t *testing.T) {
+	query := BoundQuery{
+		Values:     map[string]any{"event": "open"},
+		ParamOrder: []string{"event", "event"},
+		Binding:    BindingNumberedMap,
+	}
+	values, err := query.NumberedMap()
+	if err != nil {
+		t.Fatalf("NumberedMap() error = %v", err)
+	}
+	if values["p1"] != "open" || values["p2"] != "open" {
+		t.Fatalf("unexpected numbered map: %#v", values)
+	}
+}
