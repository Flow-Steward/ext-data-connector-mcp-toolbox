diff --git a/internal/util/flowstewardbinding/binding.go b/internal/util/flowstewardbinding/binding.go
new file mode 100644
index 0000000..25f3233
--- /dev/null
+++ b/internal/util/flowstewardbinding/binding.go
@@ -0,0 +1,148 @@
+// Copyright 2026 Flow Steward
+// Licensed under the Apache License, Version 2.0.
+
+package flowstewardbinding
+
+import (
+	"bytes"
+	"database/sql"
+	"encoding/json"
+	"fmt"
+
+	"github.com/googleapis/mcp-toolbox/internal/util"
+	"github.com/googleapis/mcp-toolbox/internal/util/parameters"
+)
+
+const (
+	BindingNamed           = "named"
+	BindingNamedPositional = "named-positional"
+	BindingNumberedMap     = "numbered-map"
+	BindingNumbered        = "numbered"
+	BindingPositional      = "positional"
+)
+
+type BoundQuery struct {
+	SQL        string
+	Values     map[string]any
+	ParamOrder []string
+	Binding    string
+}
+
+func ToolParameters() parameters.Parameters {
+	return parameters.Parameters{
+		parameters.NewStringParameter("sql", "The SQL statement with driver placeholders."),
+		parameters.NewStringParameter("params_json", "Canonical JSON named runtime values bound by the database driver."),
+		parameters.NewArrayParameter(
+			"param_order",
+			"Parameter names in placeholder occurrence order.",
+			parameters.NewStringParameter("name", "A declared parameter name."),
+		),
+		parameters.NewStringParameter("binding", "The selected driver binding strategy."),
+	}
+}
+
+func Parse(values parameters.ParamValues) (BoundQuery, error) {
+	input := values.AsMap()
+	statement, ok := input["sql"].(string)
+	if !ok || statement == "" {
+		return BoundQuery{}, fmt.Errorf("sql parameter must be a non-empty string")
+	}
+	paramsJSON, ok := input["params_json"].(string)
+	if !ok {
+		return BoundQuery{}, fmt.Errorf("params_json parameter must be a JSON object string")
+	}
+	decoder := json.NewDecoder(bytes.NewBufferString(paramsJSON))
+	decoder.UseNumber()
+	params := map[string]any{}
+	if err := decoder.Decode(&params); err != nil {
+		return BoundQuery{}, fmt.Errorf("params_json parameter must contain a JSON object: %w", err)
+	}
+	convertedParams, err := util.ConvertNumbers(params)
+	if err != nil {
+		return BoundQuery{}, fmt.Errorf("params_json contains an unsupported number: %w", err)
+	}
+	params, ok = convertedParams.(map[string]any)
+	if !ok {
+		return BoundQuery{}, fmt.Errorf("params_json parameter must contain a JSON object")
+	}
+	rawOrder, ok := input["param_order"].([]any)
+	if !ok {
+		return BoundQuery{}, fmt.Errorf("param_order parameter must be an array")
+	}
+	order := make([]string, 0, len(rawOrder))
+	for index, value := range rawOrder {
+		name, ok := value.(string)
+		if !ok || name == "" {
+			return BoundQuery{}, fmt.Errorf("param_order[%d] must be a non-empty string", index)
+		}
+		if _, exists := params[name]; !exists {
+			return BoundQuery{}, fmt.Errorf("param_order references missing parameter %q", name)
+		}
+		order = append(order, name)
+	}
+	binding, ok := input["binding"].(string)
+	if !ok || !supportedBinding(binding) {
+		return BoundQuery{}, fmt.Errorf("unsupported binding strategy %q", binding)
+	}
+	return BoundQuery{SQL: statement, Values: params, ParamOrder: order, Binding: binding}, nil
+}
+
+func supportedBinding(binding string) bool {
+	switch binding {
+	case BindingNamed, BindingNamedPositional, BindingNumberedMap, BindingNumbered, BindingPositional:
+		return true
+	default:
+		return false
+	}
+}
+
+func (q BoundQuery) Positional() ([]any, error) {
+	if q.Binding != BindingPositional && q.Binding != BindingNumbered {
+		return nil, fmt.Errorf("binding %q is not positional", q.Binding)
+	}
+	result := make([]any, 0, len(q.ParamOrder))
+	for _, name := range q.ParamOrder {
+		result = append(result, q.Values[name])
+	}
+	return result, nil
+}
+
+func (q BoundQuery) NamedPositional() ([]any, error) {
+	if q.Binding != BindingNamedPositional {
+		return nil, fmt.Errorf("binding %q is not named-positional", q.Binding)
+	}
+	result := make([]any, 0, len(q.ParamOrder))
+	for index, name := range q.ParamOrder {
+		result = append(result, sql.Named(fmt.Sprintf("p%d", index+1), q.Values[name]))
+	}
+	return result, nil
+}
+
+func (q BoundQuery) ParamValues() (parameters.ParamValues, error) {
+	if q.Binding != BindingPositional {
+		return nil, fmt.Errorf("binding %q is not positional", q.Binding)
+	}
+	result := make(parameters.ParamValues, 0, len(q.ParamOrder))
+	for _, name := range q.ParamOrder {
+		result = append(result, parameters.ParamValue{Name: name, Value: q.Values[name]})
+	}
+	return result, nil
+}
+
+func (q BoundQuery) NamedMap() (map[string]any, error) {
+	if q.Binding != BindingNamed {
+		return nil, fmt.Errorf("binding %q is not named", q.Binding)
+	}
+	return q.Values, nil
+}
+
+func (q BoundQuery) NumberedMap() (map[string]any, error) {
+	if q.Binding != BindingNumberedMap {
+		return nil, fmt.Errorf("binding %q is not numbered-map", q.Binding)
+	}
+	result := make(map[string]any, len(q.ParamOrder))
+	for index, name := range q.ParamOrder {
+		result[fmt.Sprintf("p%d", index+1)] = q.Values[name]
+	}
+	return result, nil
+}
diff --git a/internal/util/flowstewardbinding/binding_test.go b/internal/util/flowstewardbinding/binding_test.go
new file mode 100644
index 0000000..2e44dc6
--- /dev/null
+++ b/internal/util/flowstewardbinding/binding_test.go
@@ -0,0 +1,82 @@
+// Copyright 2026 Flow Steward
+// Licensed under the Apache License, Version 2.0.
+
+package flowstewardbinding
+
+import (
+	"encoding/json"
+	"testing"
+
+	"github.com/googleapis/mcp-toolbox/internal/util/parameters"
+)
+
+func TestBoundQueryPreservesLargeInteger(t *testing.T) {
+	query, err := Parse(parameters.ParamValues{
+		{Name: "sql", Value: "SELECT id FROM events WHERE id = $1"},
+		{Name: "params_json", Value: `{"id":9007199254740993}`},
+		{Name: "param_order", Value: []any{"id"}},
+		{Name: "binding", Value: BindingNumbered},
+	})
+	if err != nil {
+		t.Fatalf("Parse() error = %v", err)
+	}
+	values, err := query.Positional()
+	if err != nil {
+		t.Fatalf("Positional() error = %v", err)
+	}
+	if got, ok := values[0].(int64); !ok || got != 9007199254740993 {
+		t.Fatalf("large integer lost precision: %#v", values[0])
+	}
+	if _, ok := query.Values["id"].(json.Number); ok {
+		t.Fatal("large integer was not converted for the database driver")
+	}
+}
