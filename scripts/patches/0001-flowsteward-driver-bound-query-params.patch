+func TestBoundValuesRemainSeparateAndRepeated(t *testing.T) {
+	query, err := Parse(parameters.ParamValues{
+		{Name: "sql", Value: "SELECT * FROM events WHERE event = $1 OR parent = $2"},
+		{Name: "params_json", Value: `{"event":"x' OR 1=1 --"}`},
+		{Name: "param_order", Value: []any{"event", "event"}},
+		{Name: "binding", Value: BindingNumbered},
+	})
+	if err != nil {
+		t.Fatalf("Parse() error = %v", err)
+	}
+	values, err := query.Positional()
+	if err != nil {
+		t.Fatalf("Positional() error = %v", err)
+	}
+	if query.SQL != "SELECT * FROM events WHERE event = $1 OR parent = $2" {
+		t.Fatalf("SQL was modified with a runtime value: %q", query.SQL)
+	}
+	if len(values) != 2 || values[0] != "x' OR 1=1 --" || values[1] != values[0] {
+		t.Fatalf("unexpected positional values: %#v", values)
+	}
+}
