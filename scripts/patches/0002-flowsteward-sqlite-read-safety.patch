@@ -0,0 +1,66 @@
+// Copyright 2026 Flow Steward. Licensed under the Apache License, Version 2.0.
+package sqlite
+
+import (
+	"context"
+	"database/sql"
+	"path/filepath"
+	"testing"
+)
+
+func TestFlowStewardBoundReadProtectsSentinel(t *testing.T) {
+	db, err := sql.Open("sqlite", filepath.Join(t.TempDir(), "sentinel.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if _, err = db.Exec("CREATE TABLE products(sku TEXT PRIMARY KEY)"); err != nil {
+		t.Fatal(err)
+	}
+	if _, err = db.Exec("INSERT INTO products(sku) VALUES ('keep')"); err != nil {
+		t.Fatal(err)
+	}
+	source := Source{Db: db}
+	for _, payload := range []string{`SELECT '\'; DELETE FROM products; -- '`, `SELECT sku FROM products; DELETE FROM products`, `WITH x AS (SELECT 1) DELETE FROM products`, `SELECT 1; PRAGMA query_only=OFF; DELETE FROM products`} {
+		if _, err = source.RunSQL(context.Background(), payload, nil); err == nil {
+			t.Fatalf("unsafe read accepted: %q", payload)
+		}
+		var count int
+		if err = db.QueryRow("SELECT COUNT(*) FROM products").Scan(&count); err != nil || count != 1 {
+			t.Fatalf("sentinel changed: %d %v", count, err)
+		}
+	}
+	if _, err = source.RunSQL(context.Background(), `SELECT 'a''; DELETE FROM products --' AS note`, nil); err != nil {
+		t.Fatalf("safe quoted text refused: %v", err)
+	}
+}
+
+func TestFlowStewardBoundReadCapsActualNativeRowsAndBytes(t *testing.T) {
+	db, err := sql.Open("sqlite", filepath.Join(t.TempDir(), "bounded.db"))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer db.Close()
+	if _, err = db.Exec("CREATE TABLE products(sku INTEGER)"); err != nil {
+		t.Fatal(err)
+	}
+	for i := 0; i < 300; i++ {
+		if _, err = db.Exec("INSERT INTO products(sku) VALUES (?)", i); err != nil {
+			t.Fatal(err)
+		}
+	}
+	source := Source{Db: db}
+	for _, query := range []string{"SELECT sku FROM products", "SELECT sku FROM products LIMIT 1+1000000", "SELECT sku FROM products LIMIT 1,1000000"} {
+		rows, err := source.RunSQL(context.Background(), query, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		values, ok := rows.([]any)
+		if !ok || len(values) > 101 {
+			t.Fatalf("native result escaped row cap: %T %#v", rows, rows)
+		}
+	}
+	if _, err = source.RunSQL(context.Background(), "SELECT zeroblob(500000) AS payload", nil); err == nil {
+		t.Fatal("native inline byte budget was not enforced")
+	}
+}
