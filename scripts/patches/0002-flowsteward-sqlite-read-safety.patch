--- /dev/null
+++ b/internal/sources/sqlite/flowsteward_read.go
@@ -0,0 +1,107 @@
+// Copyright 2026 Flow Steward. Licensed under the Apache License, Version 2.0.
+package sqlite
+
+import (
+	"fmt"
+	"strings"
+	"unicode"
+)
+
+// boundedReadSQL applies SQLite lexical rules before the driver can see a read.
+// SQLite ordinary strings never use backslash escaping. No second statement,
+// mutating keyword or file/extension primitive can pass through this path.
+func boundedReadSQL(statement string) (string, error) {
+	if len(statement) == 0 || len(statement) > 65536 || strings.Contains(statement, "\\") {
+		return "", fmt.Errorf("invalid bounded SQLite read SQL")
+	}
+	first := ""
+	ended := false
+	terminator := -1
+	forbidden := map[string]bool{"insert": true, "update": true, "delete": true, "replace": true, "create": true, "alter": true, "drop": true, "attach": true, "detach": true, "pragma": true, "vacuum": true, "reindex": true, "analyze": true, "begin": true, "commit": true, "rollback": true, "savepoint": true, "release": true, "load_extension": true, "readfile": true, "writefile": true}
+	for index := 0; index < len(statement); {
+		char := statement[index]
+		if unicode.IsSpace(rune(char)) {
+			index++
+			continue
+		}
+		if strings.HasPrefix(statement[index:], "--") {
+			next := strings.IndexByte(statement[index:], '\n')
+			if next < 0 {
+				break
+			}
+			index += next + 1
+			continue
+		}
+		if strings.HasPrefix(statement[index:], "/*") {
+			next := strings.Index(statement[index+2:], "*/")
+			if next < 0 {
+				return "", fmt.Errorf("unterminated SQLite comment")
+			}
+			index += next + 4
+			continue
+		}
+		if ended {
+			return "", fmt.Errorf("exactly one SQLite read statement is required")
+		}
+		if char == ';' {
+			ended = true
+			terminator = index
+			index++
+			continue
+		}
+		if char == '\'' || char == '"' || char == '`' || char == '[' {
+			close := char
+			if char == '[' {
+				close = ']'
+			}
+			index++
+			closed := false
+			for index < len(statement) {
+				if statement[index] == close {
+					if close != ']' && index+1 < len(statement) && statement[index+1] == close {
+						index += 2
+						continue
+					}
+					index++
+					closed = true
+					break
+				}
+				index++
+			}
+			if !closed {
+				return "", fmt.Errorf("unterminated SQLite quoted value")
+			}
+			continue
+		}
+		if char == '_' || char >= 'A' && char <= 'Z' || char >= 'a' && char <= 'z' {
+			end := index + 1
+			for end < len(statement) {
+				next := statement[end]
+				if !(next == '_' || next >= 'A' && next <= 'Z' || next >= 'a' && next <= 'z' || next >= '0' && next <= '9') {
+					break
+				}
+				end++
+			}
+			word := strings.ToLower(statement[index:end])
+			if first == "" {
+				first = word
+			}
+			if forbidden[word] {
+				return "", fmt.Errorf("only SQLite read SQL is allowed")
+			}
+			index = end
+			continue
+		}
+		index++
+	}
+	if first != "select" && first != "with" {
+		return "", fmt.Errorf("only SQLite SELECT is allowed")
+	}
+	// Remove only a lexically verified trailing terminator; trailing comments are
+	// safe inside the derived query, with a newline protecting the closing syntax.
+	if terminator >= 0 {
+		statement = statement[:terminator] + statement[terminator+1:]
+	}
+	trimmed := strings.TrimSpace(statement)
+	return "SELECT * FROM (\n" + trimmed + "\n) AS flow_steward_bounded LIMIT 101", nil
+}
